#!/bin/sh /etc/rc.common
#
# LAN Share · procd 启动脚本（直连模式 · 精简版）
#
# 这一份刻意去掉了所有「锦上添花」的东西，只留最小可用集，
# 用来排查 / 兼容旧的 procd：
#   - 不要 procd_add_mount_trigger（依赖较新的 procd.sh）
#   - 不要 procd_set_param file
#   - 不要 stop_service（procd 自己会发 TERM 并回收，不需要手写）
#   - procd_set_param 一律写成单行，不用反斜杠续行
#
# 安装：
#   cp 本文件 /etc/init.d/lan-share
#   chmod +x /etc/init.d/lan-share
#   /etc/init.d/lan-share enable
#   /etc/init.d/lan-share start
#
# 注意：上传后务必确认没有 Windows 行尾（CRLF）。
#   busybox 下 CRLF 会让 USE_PROCD=1 变成 "1\r"，行为走样。
#   检查：grep -c $'\r' /etc/init.d/lan-share    → 应当输出 0
#   修正：tr -d '\r' < /etc/init.d/lan-share > /tmp/ls.init && mv /tmp/ls.init /etc/init.d/lan-share

START=95
USE_PROCD=1

ROOT="/mnt/data_mmcblk0p27/lan-share"
PROG="/mnt/data_mmcblk0p27/lan-share/lan-share"
LISTEN="0.0.0.0:18080"

start_service() {
    mkdir -p "$ROOT/data" "$ROOT/files/permanent" "$ROOT/files/temporary" "$ROOT/files/chat" "$ROOT/logs"

    procd_open_instance
    procd_set_param command "$PROG"
    procd_set_param env LANSHARE_ROOT="$ROOT"
    procd_set_param env LANSHARE_LISTEN="$LISTEN"
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
