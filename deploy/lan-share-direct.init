#!/bin/sh /etc/rc.common
#
# LAN Share · Kwrt/OpenWrt procd 启动脚本（直连模式）
#
# ============================================================================
# 与 lan-share.init（nginx 反代模式）的区别：
#
#   本脚本让 Go 直接监听 0.0.0.0:18080，**不经过任何反代**。
#   好处是部署简单 —— 不需要装/配 nginx，路由器上少一层东西。
#
#   ⚠️ 代价是安全档位降低了：整个局域网（含校园网口）都能直接访问 18080。
#      当前权限模型下，这意味着任何人都可以：
#        - 浏览并下载文件仓库里的全部文件
#        - 创建聊天房间（会占内存，房间到期才释放）
#      上传和删除仍然需要登录，这一点没变。
#
#      如果你要的是「只有内网能访问」，用回 lan-share.init + nginx。
#      如果你就是局域网自用、图省事，这份脚本没问题。
#
# 注意：本机的 18080 只允许一个进程监听。若你之前起过别的实例，
#       必须先停掉，否则会 bind: address already in use。
#
# ============================================================================
#
# 安装位置：/etc/init.d/lan-share
# 使用方式：
#   /etc/init.d/lan-share enable     # 开机自启
#   /etc/init.d/lan-share start / stop / restart / status
#
# 依赖：程序自身是静态链接的 ARM64 单二进制，不依赖 libc/glibc，
#       因此不需要在这里声明 DEPENDS。
#
# ---------------------------------------------------------------------------
# procd 写法上的三条硬约束（都是实际踩过的坑，改动时务必保留）：
#
#   1) procd_open_instance 必须带**显式实例名**。
#      虽然 API 文档称实例名可省略，但部分 Kwrt 组合下会报
#      「procd.sh: shift: shift count out of range」。带个名字最简单。
#
#   2) env 在 procd 的 JSON 里是一个 **table**，只能一次性给全。
#      多次调用 procd_set_param env 会反复重建这个 table，
#      结果常常只留下最后一次 —— 表现为程序回退到默认监听 127.0.0.1。
#      要追加请用 procd_append_param env。
#
#   3) 不要直接调用底层的 procd_add_mount_trigger。
#      它还需要 event/action 等参数，参数不足同样触发
#      「shift count out of range」。start_service 里已经有最多 30 秒的
#      等待逻辑兜住「数据分区挂载得比服务晚」，这里不需要 trigger。
#
# 注意：上传后务必确认没有 Windows 行尾（CRLF）。
#   busybox 下 CRLF 会让 USE_PROCD=1 变成 "1\r"，行为走样。
#   检查：grep -c $'\r' /etc/init.d/lan-share    → 应当输出 0
#   修正：tr -d '\r' < /etc/init.d/lan-share > /tmp/ls.init && mv /tmp/ls.init /etc/init.d/lan-share
# ---------------------------------------------------------------------------

START=95
STOP=95
USE_PROCD=1

# 数据分区根目录。所有持久化内容（数据库/文件/日志）都放这里，
# 绝不写 Overlay，避免反复擦写把路由器闪存写坏。
#
# 你的环境里 /data 就是 /mnt/data_mmcblk0p27 的软链，
# 两个路径等价 —— 这里用真实挂载点，避免依赖软链。
ROOT="/mnt/data_mmcblk0p27/lan-share"
PROG="$ROOT/lan-share"

# 直连：监听所有网卡。改成具体 IP（如 10.0.0.1:18080）也能收窄范围。
LISTEN="0.0.0.0:18080"

start_service() {
	# 数据分区可能挂载得比本服务晚；这里做一次兜底等待。
	local i=0
	while [ ! -d "$ROOT" ] && [ "$i" -lt 30 ]; do
		sleep 1
		i=$((i + 1))
	done

	if [ ! -d "$ROOT" ]; then
		logger -t lan-share "数据目录 $ROOT 不存在，无法启动"
		return 1
	fi

	if [ ! -x "$PROG" ]; then
		logger -t lan-share "程序 $PROG 不存在或不可执行，无法启动"
		return 1
	fi

	# 首次运行自动补建数据目录，免得用户手动 mkdir。
	# tmp 目录给 Go 的 os.CreateTemp 用（见下面 TMPDIR 的说明）。
	mkdir -p \
		"$ROOT/data" \
		"$ROOT/files/permanent" \
		"$ROOT/files/chat" \
		"$ROOT/logs" \
		"$ROOT/tmp"

	procd_open_instance main

	procd_set_param command "$PROG"

	# 环境变量一次性给全（env 是 table，见文件头第 2 条）。
	#
	# TMPDIR 这条不是可选项：OpenWrt 的 /tmp 是 tmpfs，也就是内存。
	# Go 标准库（multipart、os.CreateTemp）默认往 TMPDIR 落临时文件，
	# 于是上传一个 100MB 的文件就等于吃掉 100MB 内存 —— 曾因此在
	# 传 125MB 文件时被内核 OOM Killer 直接杀掉。指到数据分区后，
	# 临时文件才是真正写在 ext4 上，不占 RAM。
	procd_set_param env \
		"LANSHARE_ROOT=$ROOT" \
		"LANSHARE_LISTEN=$LISTEN" \
		"TMPDIR=$ROOT/tmp"

	# 异常退出自动重启；限流避免「启动即崩溃」时疯狂重启拖垮路由器。
	procd_set_param respawn 3600 5 5

	# 日志交给 procd 的 stdout 收集（logread 可查）。
	# 文件日志由程序自己写到 $ROOT/logs/ 并做大小轮转。
	procd_set_param stdout 1
	procd_set_param stderr 1

	procd_close_instance
}
